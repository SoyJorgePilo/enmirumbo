// Modelo de datos del directorio (spec: modelo-datos · ticket T-001).
//
// PostgreSQL en TODOS los entornos —desarrollo, pruebas, CI y producción—
// (ADR-004, ejecutado en T-013 / change `preparar-deploy-produccion`,
// design.md §2 opción C). Un solo `provider`, un solo árbol de migraciones y
// un solo dialecto: el que corre en Supabase es el que corre en la laptop.
// Enmienda ADR-001, que había elegido SQLite para desarrollo.
//
// `estado`, `origen`, `Reporte.motivo` y `Reporte.estado` son String con
// CHECK escritos A MANO en la migración inicial: Prisma no los expresa en el
// esquema. Los literales válidos viven en src/lib/negocio.ts,
// src/lib/reportes/motivos.ts y src/lib/reportes/estados.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Catálogos (poblados por prisma/seed.ts, slugs para URLs SEO) ────────────

model Categoria {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

model Colonia {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

model Giro {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

// ── Negocio (PRD §6.1, §6.3, §6.4) ──────────────────────────────────────────

model Negocio {
  id String @id @default(cuid())

  // Obligatorios del registro (PRD §6.1)
  nombre           String
  categoria        Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId      Int
  whatsapp         String    @unique // una sola ficha por número
  // Constancia LFPDPPP del checkbox del aviso de privacidad (PRD §8). Es un
  // PAR y viaja junto (change `versionar-aviso-privacidad`): cuándo consintió
  // y contra QUÉ texto. Sin la versión, la fecha apunta a un aviso que pudo
  // haber cambiado. Ni la fecha ni la versión se sustituyen en un reenvío.
  consintioAvisoEn DateTime
  // Versión del aviso vigente al dar el consentimiento. Nulable y sin default
  // a propósito: las fichas anteriores al versionado se quedan nulas porque
  // nadie puede afirmar hoy qué texto tuvieron enfrente (design.md §2).
  consintioAvisoVersion String?

  // Reaceptación: la última vez que un reenvío aceptó una versión POSTERIOR a
  // la de la constancia original. No se escribe cuando la vigente es la misma,
  // cuando es anterior (despliegue revertido) ni cuando la constancia no tiene
  // versión, que no es comparable (hallazgos MEDIO-3 y MEDIO-4 de la etapa C).
  // Complementa a la constancia, no la sustituye. Las dos nulas mientras eso
  // no ocurra, y también inseparables.
  reconsintioAvisoEn      DateTime?
  reconsintioAvisoVersion String?

  // Colonia: del catálogo, u "Otra" con texto libre pendiente de normalizar
  // (pendiente = coloniaId nulo con coloniaOtra no vacío; ver design.md §2)
  colonia     Colonia? @relation(fields: [coloniaId], references: [id])
  coloniaId   Int?
  coloniaOtra String?

  // Opcionales del registro (PRD §6.1)
  queOfreces         String? // máx. 200 caracteres (se valida en el formulario)
  entregaADomicilio  Boolean @default(false)
  telefonoFijo       String?
  direccion          String? // dirección o referencias en texto libre
  latitud            Float? // pin opcional en mapa
  longitud           Float?
  horario            String?
  // Referencia interna a la foto (change `agregar-foto-negocio`, design.md §4):
  // clave OPACA que genera el servidor al procesar la imagen, nunca una URL ni
  // una ruta del sistema de archivos. Los bytes viven en el almacén de fotos
  // (ADR-006), fuera de la base y fuera del repositorio. Es única entre
  // negocios: dos fichas no pueden apuntar a los mismos archivos.
  fotoClave          String?  @unique
  facebookUrl        String?

  // Texto derivado SOLO para el buscador (change `agregar-buscador`,
  // design.md §1): copia sin acentos ni mayúsculas de `nombre` y `queOfreces`,
  // porque la base no compara ignorando acentos (ni SQLite entonces, ni
  // PostgreSQL sin extensiones hoy). Nunca se editan a mano ni se
  // muestran: los calcula `datosDeBusqueda` (src/lib/busqueda.ts) en cada
  // escritura. El default "" existe solo para poder migrar filas ya guardadas;
  // `npm run db:backfill:busqueda` las rellena.
  nombreNormalizado     String @default("")
  queOfrecesNormalizado String @default("")

  // Ciclo de vida (PRD §6.3 y §10; CHECKs en la migración inicial)
  estado      String    @default("en_revision") // en_revision | publicado | rechazado
  origen      String    @default("organico") // siembra | organico
  registradoEn DateTime @default(now())
  publicadoEn  DateTime?

  // Rastro del rechazo (PRD §6.3 y §8): nulos mientras el negocio no haya
  // sido rechazado, y vuelven a nulos si corrige y reenvía. `rechazadoEn` es
  // lo que habilitará la purga de rechazados a los 90 días (E0-3).
  rechazadoEn   DateTime?
  motivoRechazo String?

  // Rastro de la última despublicación (spec `modelo-datos`, requirement "El
  // negocio guarda el rastro de su despublicación"): nulos mientras la ficha
  // nunca se haya despublicado, y se sobrescriben en cada despublicación
  // posterior. NO se limpian en ninguna transición: son historia útil dentro
  // del panel. Para que ese rastro viejo no ensucie la cola, la espera se
  // cuenta desde `max(registradoEn, despublicadoEn)` (src/lib/admin/consultas.ts).
  // El motivo es un dato interno del panel, como `motivoRechazo`: nunca sale
  // a una página pública.
  despublicadoEn       DateTime?
  motivoDespublicacion String?

  // Giros asignados por el admin al aprobar (PRD §6.3, Apéndice B)
  giros Giro[]

  // Avisos de los vecinos sobre esta ficha (change `agregar-boton-reportar`).
  // Se borran con el negocio (ARCO, PRD §8): la cascada está en `Reporte`.
  reportes Reporte[]

  // Reservado para el enlace de gestión de P1 (PRD §6.4): nulo y sin lógica en el MVP
  tokenGestion String? @unique
}

// ── Reporte (PRD §6.3 y §13: botón "Reportar" de la ficha) ──────────────────

/**
 * Aviso de un vecino sobre una ficha publicada. NO tiene —ni debe tener—
 * ninguna columna del reportante: el formulario es anónimo y la IP solo se
 * usa en memoria para el cupo de la hora (PRD §8 y LFPDPPP: lo que no se
 * guarda no se puede filtrar).
 *
 * `motivo` y `estado` son texto con CHECK en la migración, igual que
 * `estado`/`origen` del negocio. Texto con CHECK y no un enum de PostgreSQL a
 * propósito: agregar un valor a un enum es DDL que bloquea la tabla y el
 * vocabulario ya vive en TypeScript. Los valores
 * válidos viven en `src/lib/reportes/motivos.ts` y `src/lib/reportes/estados.ts`.
 */
model Reporte {
  id String @id @default(cuid())

  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  negocioId String

  motivo String // cerrado | no_real | datos_incorrectos | inapropiado

  // Opcional; la cota de 300 caracteres se hace cumplir en el formulario.
  comentario String?

  estado     String    @default("pendiente") // pendiente | atendido
  creadoEn   DateTime  @default(now())
  atendidoEn DateTime?

  // La cola del panel pregunta siempre "pendientes de este negocio".
  @@index([negocioId, estado])
}

// ── Cupos anti-abuso compartidos (PRD §8) ───────────────────────────────────

/**
 * Un intento contado contra un cupo, en la base y no en la memoria del proceso
 * (change `preparar-deploy-produccion`, iteración 2, hallazgo A4 de la etapa
 * C). En un hosting serverless (ADR-007) cada instancia tiene su propia
 * memoria: un contador en RAM le da al atacante tantos intentos como
 * instancias consiga levantar, y se evapora cuando la instancia se recicla.
 *
 * HOY LO USA UN SOLO CUPO: los intentos de acceso al panel, que es lo único
 * que protege `PANEL_CONTRASENA` —la única credencial del sitio, sin cuentas,
 * sin MFA y sin recuperación—. Los cupos del formulario público y de los
 * reportes NO viven aquí: el aviso de privacidad publicado promete que la IP
 * de un vecino se usa "solo en su memoria" y que "no la guardamos en la base
 * de datos", y ese texto no se toca en este change (ver `docs/despliegue.md`
 * §10 y `PENDIENTES_OPERATIVOS_LEGALES`).
 *
 * `clave` NO es una IP: es un HMAC-SHA256 de la IP con el secreto de sesión
 * del panel, truncado. No se puede volver atrás sin el secreto y no sirve para
 * cruzar con nada. Las filas se borran al salir de su ventana cuando se vuelve
 * a contar esa clave, y la tarea programada diaria recoge las demás y poda la
 * tabla si pasa de su techo (`limpiarCuposCaducados`).
 */
model IntentoDeCupo {
  id String @id @default(cuid())

  /** Cupo + procedencia, ya derivada: nunca un dato directo de nadie. */
  clave String

  /** Cuándo ocurrió. La ventana deslizante se cuenta sobre esto. */
  ocurrioEn DateTime @default(now())

  // La única pregunta que se hace: "cuántos de esta clave desde tal momento".
  @@index([clave, ocurrioEn])
}

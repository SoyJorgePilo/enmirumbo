# Variables del spike de Astro (T-021). Copia como .env para correr en local;
# en el preview van en las variables de entorno del proyecto de Vercel del
# spike (NUNCA en el de producción). El .env real no se commitea.

# Secreto con el que se firma la cookie de sesión del spike (HMAC-SHA256).
# Mínimo 32 caracteres. Sin él, /acceso falla a la vista (503) y no emite
# ninguna cookie. Genéralo con:  openssl rand -base64 32
SPIKE_SESION_SECRETO=

# Base PostgreSQL DESECHABLE con datos ficticios (nunca la de producción).
# - En local: la de `npm run db:local` de la raíz (no exige TLS por ser de
#   esta máquina):
#     postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable
# - En el preview (Supabase desechable): TLS verificado contra la CA de
#   Supabase que viaja con la función (includeFiles en astro.config.mjs):
#     postgresql://USUARIO:CLAVE@HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root-2021-ca.crt
# Sin URL, sin verify-full o sin el certificado, /negocios responde 503 con
# un error visible y no muestra datos.
DATABASE_URL=

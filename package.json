{
  "name": "directorio-tizayuca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint",
    "typecheck": "next typegen && astro check",
    "test": "vitest run",
    "db:local": "prisma dev --name enmirumbo",
    "db:local:detener": "prisma dev stop enmirumbo",
    "db:migrar": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:backfill:busqueda": "tsx prisma/backfill-busqueda.ts",
    "fotos:barrer-huerfanos": "tsx prisma/barrer-fotos-huerfanas.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "astro": "^7.3.5",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}

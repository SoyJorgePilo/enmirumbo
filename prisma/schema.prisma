// Modelo de datos del directorio (spec: modelo-datos · ticket T-001).
// SQLite en dev (ADR-001): estado y origen son String con CHECK en la
// migración inicial; los literales válidos viven en src/lib/negocio.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Catálogos (poblados por prisma/seed.ts, slugs para URLs SEO) ────────────

model Categoria {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

model Colonia {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

model Giro {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  slug     String    @unique
  negocios Negocio[]
}

// ── Negocio (PRD §6.1, §6.3, §6.4) ──────────────────────────────────────────

model Negocio {
  id String @id @default(cuid())

  // Obligatorios del registro (PRD §6.1)
  nombre           String
  categoria        Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId      Int
  whatsapp         String    @unique // una sola ficha por número
  consintioAvisoEn DateTime // constancia del checkbox del aviso de privacidad

  // Colonia: del catálogo, u "Otra" con texto libre pendiente de normalizar
  // (pendiente = coloniaId nulo con coloniaOtra no vacío; ver design.md §2)
  colonia     Colonia? @relation(fields: [coloniaId], references: [id])
  coloniaId   Int?
  coloniaOtra String?

  // Opcionales del registro (PRD §6.1)
  queOfreces         String? // máx. 200 caracteres (se valida en el formulario)
  entregaADomicilio  Boolean @default(false)
  telefonoFijo       String?
  direccion          String? // dirección o referencias en texto libre
  latitud            Float? // pin opcional en mapa
  longitud           Float?
  horario            String?
  fotoUrl            String?
  facebookUrl        String?

  // Texto derivado SOLO para el buscador (change `agregar-buscador`,
  // design.md §1): copia sin acentos ni mayúsculas de `nombre` y `queOfreces`,
  // porque SQLite no compara ignorando acentos. Nunca se editan a mano ni se
  // muestran: los calcula `datosDeBusqueda` (src/lib/busqueda.ts) en cada
  // escritura. El default "" existe solo para poder migrar filas ya guardadas;
  // `npm run db:backfill:busqueda` las rellena.
  nombreNormalizado     String @default("")
  queOfrecesNormalizado String @default("")

  // Ciclo de vida (PRD §6.3 y §10; CHECKs en la migración inicial)
  estado      String    @default("en_revision") // en_revision | publicado | rechazado
  origen      String    @default("organico") // siembra | organico
  registradoEn DateTime @default(now())
  publicadoEn  DateTime?

  // Rastro del rechazo (PRD §6.3 y §8): nulos mientras el negocio no haya
  // sido rechazado, y vuelven a nulos si corrige y reenvía. `rechazadoEn` es
  // lo que habilitará la purga de rechazados a los 90 días (E0-3).
  rechazadoEn   DateTime?
  motivoRechazo String?

  // Rastro de la última despublicación (spec `modelo-datos`, requirement "El
  // negocio guarda el rastro de su despublicación"): nulos mientras la ficha
  // nunca se haya despublicado, y se sobrescriben en cada despublicación
  // posterior. NO se limpian en ninguna transición: son historia útil dentro
  // del panel. Para que ese rastro viejo no ensucie la cola, la espera se
  // cuenta desde `max(registradoEn, despublicadoEn)` (src/lib/admin/consultas.ts).
  // El motivo es un dato interno del panel, como `motivoRechazo`: nunca sale
  // a una página pública.
  despublicadoEn       DateTime?
  motivoDespublicacion String?

  // Giros asignados por el admin al aprobar (PRD §6.3, Apéndice B)
  giros Giro[]

  // Reservado para el enlace de gestión de P1 (PRD §6.4): nulo y sin lógica en el MVP
  tokenGestion String? @unique
}
